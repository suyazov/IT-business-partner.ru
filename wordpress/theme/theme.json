{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {"contentSize": "780px", "wideSize": "1280px"},
    "color": {"palette": [
      {"slug": "paper", "name": "Бумага", "color": "#f6f5ef"},
      {"slug": "ink", "name": "Графит", "color": "#202923"},
      {"slug": "lime", "name": "Лайм", "color": "#d7edaa"},
      {"slug": "muted", "name": "Серый", "color": "#60675e"}
    ]},
    "typography": {"fluid": true, "fontFamilies": [{"slug": "sans", "name": "Системный гротеск", "fontFamily": "Arial, Helvetica, sans-serif"}],
      "fontSizes": [{"slug": "small", "name": "Мелкий", "size": "0.875rem"}, {"slug": "normal", "name": "Обычный", "size": "1.125rem"}, {"slug": "large", "name": "Крупный", "size": "1.5rem"}, {"slug": "hero", "name": "Первый экран", "size": "4.8rem"}]}
  },
  "styles": {"color": {"background": "#f6f5ef", "text": "#202923"}, "typography": {"fontFamily": "var:preset|font-family|sans", "lineHeight": "1.65"}, "spacing": {"blockGap": "1.25rem"}},
  "customTemplates": []
}
